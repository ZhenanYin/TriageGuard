# Copy this sourceable replay template to ignored .env, edit locally as needed,
# then run "source .env" from the repository root. Never commit .env.
export TRIAGEGUARD_LLM_MODE=replay
export TRIAGEGUARD_LLM_PROVIDER=groq
export TRIAGEGUARD_LLM_MODEL=openai/gpt-oss-120b
# Replay must not inherit a live credential from the current shell.
unset GROQ_API_KEY
# export GROQ_API_KEY=
# Relative artifact paths assume Streamlit starts from the repository root.
export TRIAGEGUARD_ARTIFACTS_DIR=artifacts
export TRIAGEGUARD_REPEAT_COUNT=3
export TRIAGEGUARD_ENVIRONMENT_KIND=controlled_fixture
